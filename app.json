{
  "expo": {
    "name": "Bulut",
    "slug": "bulut",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bulut.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bulut.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "name": "Bulut",
      "shortName": "Bulut",
      "themeColor": "#10B981",
      "backgroundColor": "#F3FAF6",
      "lang": "tr"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bulut, öğün fotoğraflarından kalori hesaplamak için fotoğraflarına erişir.",
          "cameraPermission": "Bulut, öğün fotoğrafı çekip kalori hesaplamak için kameraya erişir.",
          "microphonePermission": false
        }
      ],
      "expo-font"
    ],
    "scheme": "bulut",
    "experiments": {
      "typedRoutes": true
    }
  }
}
